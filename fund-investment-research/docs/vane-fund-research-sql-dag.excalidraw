      "type": "text", "id": "sql_code_text", "x": 96, "y": 842, "width": 1475, "height": 215,
      "text": "CASE\n  WHEN trusted_fact_count = 0\n    THEN 'insufficient_evidence'\n  WHEN trusted_regulatory_status_count > 1\n    THEN 'manual_review'\n  WHEN violation_count > 0\n    THEN 'thesis_review_required'\n  WHEN support_count > 0\n    THEN 'thesis_supported'\n  ELSE 'manual_review'\nEND AS state", "originalText": "CASE\n  WHEN trusted_fact_count = 0\n    THEN 'insufficient_evidence'\n  WHEN trusted_regulatory_status_count > 1\n    THEN 'manual_review'\n  WHEN violation_count > 0\n    THEN 'thesis_review_required'\n  WHEN support_count > 0\n    THEN 'thesis_supported'\n  ELSE 'manual_review'\nEND AS state",
